# RecoverAgent: https://huyoveugeexdhyqhawvq.supabase.co/functions/v1/lead-followup-api
# Other CRM webhook URLs receive the original demo form JSON.
CRM_WEBHOOK_URL=

# Dashboard: Recover Agent company lead_followup API key (required; server-only).
# Other CRM webhooks: optional Authorization: Bearer <secret>.
CRM_WEBHOOK_SECRET=

# Dashboard: Recover Agent company UUID (required). Never use a visitor-provided company ID.
CRM_COMPANY_ID=

# Supabase publishable/anon JWT for the gateway when JWT verification is enabled.
# This is the project's public key; company ingestion still requires CRM_WEBHOOK_SECRET.
CRM_GATEWAY_KEY=

# Meta Pixel — client-side conversion tracking (Events Manager → Data sources → Pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — optional server-side backup for Lead events (recommended)
# Events Manager → Data sources → your pixel → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
